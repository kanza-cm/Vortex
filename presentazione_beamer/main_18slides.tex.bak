\section{Physical Foundations}
\outlineframe{1}

\begin{frame}{Physical Background and Motivation}
  \begin{columns}[T]
    \begin{column}{0.52\textwidth}
      \begin{block}{3D Incompressible Vorticity Equation}
        \[
          \frac{\partial \boldsymbol{\omega}}{\partial t}
          + (\mathbf{u}\cdot\nabla)\boldsymbol{\omega}
          = (\boldsymbol{\omega}\cdot\nabla)\mathbf{u}
          + \nu\nabla^{2}\boldsymbol{\omega},
        \]
        \[
          \nabla\cdot\mathbf{u}=0 .
        \]
      \end{block}
    \end{column}
    \begin{column}{0.46\textwidth}
      \textbf{Physical Processes}
      \begin{itemize}
        \item Advection: non-linear transport by $\mathbf{u}$
        \item Vortex stretching: $(\boldsymbol{\omega}\cdot\nabla)\mathbf{u}$ feeds small scales
        \item Diffusion: viscous smoothing by $\nu$
        \item 3D dynamics: forward energy cascade, coherent vortex tubes
      \end{itemize}
      \vspace{0.15cm}
      \begin{block}{Building block}
        Coalescence and reconnection of two vortex tubes.
      \end{block}
    \end{column}
  \end{columns}
\end{frame}

\begin{frame}{The Physical Model: Gaussian Vortex Tubes}
  \begin{columns}[T]
    \begin{column}{0.49\textwidth}
      \textbf{Initial profile}
      \[
        \omega(r) = \frac{\Gamma}{\pi\sigma^{2}}
        \exp\!\left(-\frac{r^{2}}{\sigma^{2}}\right)
      \]
      \begin{itemize}
        \item Two co-rotating Gaussian tubes, $\sigma=0.09$
        \item Varicose separation: \\
              $d(z)=D\left(1+0.1\cos\frac{2\pi z}{L_z}\right)$
        \item $D=0.14$, $L_z=4$; free-slip walls
      \end{itemize}
    \end{column}
    \begin{column}{0.49\textwidth}
      \textbf{Two configurations}
      \begin{itemize}
        \item \textbf{Non-inclined} ($\mathrm{TILT}=0$): axes parallel to $z$
        \item \textbf{Inclined} ($\mathrm{TILT}=2$): axes cross at $z\approx 3.1$
        \item Same circulation: $\Gamma\approx 5.1\times10^{-2}$
      \end{itemize}
      \vspace{0.1cm}
      \centering
      \includegraphics[width=0.98\linewidth]{img/schema_config.png}
    \end{column}
  \end{columns}
\end{frame}

\begin{frame}{Two Configurations at $T=200$ (L7)}
  \begin{center}
    \includegraphics[width=0.97\textwidth]{img/confronto_L7_T200.png}
  \end{center}
  \vspace{0.05cm}
  \begin{itemize}\small
    \item Non-inclined (coalescence): separation $0.27\to0.01$ (collapses at $t\approx75$); $w_{\max}$ $0.98\to0.64$; enstrophy $-46\%$
    \item Inclined (reconnection): $w_{\max}$ oscillates $1.3$--$2.5$; enstrophy plateau $\approx0.13$ up to $t\approx100$, then decays to $0.098$; separation grows to $0.6$
  \end{itemize}
  \vspace{0.05cm}
  \centering{\scriptsize L7 ($128\times128\times512$), CFL $0.5$, new centered (2nd-order CN).}
\end{frame}

\section{Numerical Implementation}
\outlineframe{2}

\begin{frame}{Numerical Formulation \& Setup}
  \begin{columns}[T]
    \begin{column}{0.5\textwidth}
      \begin{block}{Solver}
        \[
          \partial_{t}\mathbf{u}+(\mathbf{u}\cdot\nabla)\mathbf{u}
          =-\nabla p+\nu\nabla^{2}\mathbf{u}
        \]
        \[
          \nabla\cdot\mathbf{u}=0
        \]
        \[
          \nabla^{2}p=\frac{1}{\Delta t}\nabla\cdot\mathbf{u}^{*},
          \quad
          \mathbf{u}_{f}\leftarrow\mathbf{u}_{f}-\Delta t\nabla p
        \]
        \begin{itemize}
          \item Basilisk centered: CUDA, fp32, fixed grid
          \item incflo/AMReX: CUDA, AMR
        \end{itemize}
      \end{block}
    \end{column}
    \begin{column}{0.47\textwidth}
      \begin{block}{Simulation Parameters}
        \begin{itemize}
          \item Core radius: $\sigma=0.09$
          \item Separation: $2d=0.28$ ($D=0.14$)
          \item Viscosity: $\nu=10^{-5}$ \\
                ($Re_{\Gamma}\approx 2.5\times10^{3}$)
          \item Grid levels: $L=4\ldots8$ \\
                ($64^{3}\to 256\times256\times1024$)
          \item CFL: $0.3$--$0.5$
          \item AMR: ratio $4$, VORTERR $0.3\ldots10^{-2}$
        \end{itemize}
      \end{block}
    \end{column}
  \end{columns}
\end{frame}

\begin{frame}{Fixed-Grid GPU: Cost Model}
  \begin{columns}[T]
    \begin{column}{0.58\textwidth}
      \centering
      {\scriptsize\setlength{\tabcolsep}{3pt}
      \begin{tabular}{@{}lccc r@{}}
        \toprule
        Level & Grid & Cells & VRAM & s/step \\
        \midrule
        L6 & $64\times64\times256$    & 1.05M & 0.15 GB & 0.2 \\
        L7 & $128\times128\times512$  & 8.4M  & 1.1 GB  & 1.6 \\
        L8 & $256\times256\times1024$ & 67.1M & 7.5 GB  & 2.8 \\
        \bottomrule
      \end{tabular}}
    \end{column}
    \begin{column}{0.39\textwidth}
      \begin{itemize}
        \item fp32: 4 bytes per value
        \item $\approx 120$ bytes/cell (fields, ghosts, multigrid, CUDA context)
        \item 8 GB $\to$ 67M cells; 16 GB $\to\approx$140M
        \item L9 (537M cells) would need $\approx$58 GB
      \end{itemize}
    \end{column}
  \end{columns}
\end{frame}

\begin{frame}{Conservation Laws \& Dynamics Diagnostics}
  \begin{columns}[T]
    \begin{column}{0.52\textwidth}
      \begin{block}{Conservation diagnostics at $T=200$ (L7)}
        \centering\small
        \begin{tabular}{@{}lrr@{}}
          \toprule
          & TILT=2 & TILT=0 \\
          \midrule
          $\Delta\Gamma/\Gamma_0$ & $-0.44\%$ & $-0.49\%$ \\
          $I(T)/I_0-1$ & $+0.381$ & $+0.238$ \\
          $Z(T)/Z(0)$ & 0.777 & 0.524 \\
          $d(T)$ & 0.635 & 0.011 \\
          \bottomrule
        \end{tabular}
        \\[0.1cm]
        {\scriptsize $\Gamma$: circulation on $z=2$; $I$: angular impulse; $d$: separation.}
      \end{block}
    \end{column}
    \begin{column}{0.46\textwidth}
      \centering
      \includegraphics[width=\linewidth]{img/cons_P_t.png}\\[0.08cm]
      \includegraphics[width=\linewidth]{img/cons_sep_t.png}
    \end{column}
  \end{columns}
  \vspace{0.1cm}
  \begin{itemize}\small
    \item Circulation on $z=2$ is \emph{not} conserved in 3D (tilting/stretching): it drops by less than $0.5\%$.
    \item Angular impulse grows ($+38\%$ / $+24\%$) and palinstrophy stays high: in 3D stretching feeds gradients, unlike the 2D balance $I(T)/I_0-1=4\nu\Gamma T/I_0$.
  \end{itemize}
\end{frame}

\begin{frame}{Grid Convergence \& Parameter Sensitivity}
  \begin{center}
    \includegraphics[width=0.92\textwidth]{img/t30_gauss_filtered.png}
  \end{center}
  \vspace{0.05cm}
  \begin{itemize}\small
    \item $T=30$, L8 reference; $L_2$ error compared on the Lf$=5$ grid with a Gaussian filter of $\sigma=3$ cells: the phase-sensitive filament content is removed.
    \item Observed order: inclined $p=1.93$ (L5$\to$L6) and $2.24$ (L6$\to$L7), fit $2.09$ over L5--L7; non-inclined $2.22$ and $2.50$, fit $2.36$.
    \item Without the filter the inclined case drops to $p\approx1.4$--$2.0$: the scheme is second order, the apparent loss is a phase error.
  \end{itemize}
\end{frame}

\begin{frame}{Poisson Solver: Elliptic Residuals}
  \begin{columns}[T]
    \begin{column}{0.52\textwidth}
      \centering\small
      \textbf{Max projection residual, $T=30$}\\[0.05cm]
      \begin{tabular}{@{}ccc r@{}}
        \toprule
        MAXLEVEL & inclined & non-incl. \\
        \midrule
        4 & 7.6e-4 & 6.7e-4 \\
        5 & 3.2e-3 & 9.8e-4 \\
        6 & 8.0e-3 & 1.9e-3 \\
        7 & 1.1e-2 & 2.3e-3 \\
        8 & 1.3e-2 & 1.5e-3 \\
        \bottomrule
      \end{tabular}
    \end{column}
    \begin{column}{0.45\textwidth}
      \begin{itemize}\small
        \item Residual grows with the level (more cells, same tolerance) but stays below $1.3\times10^{-2}$ at L8
        \item Non-inclined case: below $2.3\times10^{-3}$ at all levels
        \item Fixed-grid solver uses 2 V-cycles per step
        \item Residual is relative to $\max|\nabla\cdot\mathbf{u}^{*}/\Delta t|$
      \end{itemize}
    \end{column}
  \end{columns}
\end{frame}

\begin{frame}{Adaptive Grid: How It Is Built}
  \begin{columns}[T]
    \begin{column}{0.55\textwidth}
      \begin{itemize}
        \item Uniform base $2^{\mathrm{MINLEVEL}}$ (e.g.\ $16\times16\times64$)
        \item Refinement ratio $4$ per level; levels $=\lceil(\mathrm{MAXLEVEL}-\mathrm{MINLEVEL})/2\rceil$
        \item Tagging: $|\boldsymbol{\omega}|>\mathrm{VORTERR}$ (one threshold per level)
        \item Periodic regrid; average down/up between levels
        \item Cell budget (max\_cells): if the hierarchy explodes, thresholds are raised
      \end{itemize}
    \end{column}
    \begin{column}{0.42\textwidth}
      \centering
      \begin{tikzpicture}[scale=0.9]
        \draw[thick,fill=myblue!6] (0,0) rectangle (5,3.6);
        \draw[thick,fill=white] (1.0,0.7) rectangle (4.0,2.9);
        \draw[thick,fill=white] (1.8,1.3) rectangle (3.2,2.3);
        \node[anchor=south west,font=\scriptsize] at (0.05,0.02) {L0 ($2^{-4}$)};
        \node[anchor=north west,font=\scriptsize] at (1.05,2.85) {L1 ($2^{-6}$)};
        \node[anchor=north,font=\scriptsize] at (2.5,2.25) {L2 ($2^{-8}$)};
      \end{tikzpicture}
      \\[0.15cm]
      {\scriptsize Nested refinement: detail only where $|\boldsymbol{\omega}|$ is large.}
    \end{column}
  \end{columns}
\end{frame}

\begin{frame}{AMR on GPU: Data Structures \& Regrid Cycle}
  \begin{columns}[T]
    \begin{column}{0.55\textwidth}
      \begin{itemize}\small
        \item Each level is a \emph{BoxArray}: a list of non-overlapping boxes covering only the regions that need refinement
        \item Data: one MultiFab per field ($\boldsymbol{\omega}$, $\mathbf{u}_f$, $p$, \dots) = BoxArray + distribution mapping + device arrays (fp32)
        \item Tagging: a GPU kernel computes $|\boldsymbol{\omega}|$ cell-by-cell and flags cells above VORTERR
        \item Clustering (Berger--Oliger): flagged cells are grouped into a few large boxes, to limit kernel launches
        \item Regrid: build the new fine BoxArray, average down the fine solution, fill coarse/fine ghosts
      \end{itemize}
    \end{column}
    \begin{column}{0.43\textwidth}
      \centering
      \begin{tikzpicture}[scale=0.82]
        \draw[thick,fill=myblue!6] (0,0) rectangle (4.7,3.4);
        \node[anchor=south west,font=\scriptsize] at (0.06,0.03) {L0};
        \draw[thick,fill=white] (0.9,0.7) rectangle (2.7,2.7);
        \node[font=\scriptsize] at (1.8,1.7) {L1};
        \draw[thick,fill=white] (2.9,1.0) rectangle (4.3,3.0);
        \node[font=\scriptsize] at (3.6,2.0) {L1};
        \draw[thick,fill=myblue!20] (1.35,1.25) rectangle (2.15,2.2);
        \node[font=\scriptsize] at (1.75,1.72) {L2};
      \end{tikzpicture}
      \\[0.1cm]
      {\scriptsize every level is a set of boxes; the fine data live only inside them}
    \end{column}
  \end{columns}
\end{frame}

\begin{frame}{AMR on GPU: Execution Model \& Costs}
  \begin{columns}[T]
    \begin{column}{0.57\textwidth}
      \begin{itemize}\small
        \item Level update = sequence of GPU kernels: advection/diffusion are one kernel per box, while the Poisson solve uses a multigrid across levels
        \item Ghost cells: copy from same-level neighbours, interpolate from the coarser level; after each regrid, average down and fill patches
        \item Global reductions (norms, number of tagged cells) must complete before a regrid; kernels on a level run in order on the default stream
        \item Memory: $\approx 357$ MB per million cells, about $3\times$ the fixed grid; the arena reuses buffers
        \item Measured: 11.7M cells $\to$ 6.4 GB; $T=30$ cap: 15M cells (8 GB GPU)
      \end{itemize}
    \end{column}
    \begin{column}{0.41\textwidth}
      \centering{\scriptsize\setlength{\tabcolsep}{3pt}
      \begin{tabular}{@{}lcc@{}}
        \toprule
        & fixed & AMR \\
        \midrule
        bytes/cell & $\sim$120 B & $\sim$357 MB/M \\
        cells at 8 GB & 67M & 11--15M \\
        strength & uniform & local \\
        \bottomrule
      \end{tabular}}
    \end{column}
  \end{columns}
\end{frame}

\begin{frame}{Adaptive Grid: Error Map at $T=5$}
  \begin{columns}[T]
    \begin{column}{0.54\textwidth}
      \centering
      \includegraphics[width=\linewidth]{img/heatmap_T5.png}
    \end{column}
    \begin{column}{0.44\textwidth}
      \begin{itemize}\small
        \item $T=5$, MAXLEVEL $4$--$6$, thresholds $0.5\ldots10^{-2}$
        \item MAXLEVEL 5: error flat at $-1.09$ (grid-limited)
        \item MAXLEVEL 6: $-1.29\to-2.06$ ($L_\infty$), $-2.26\to-2.98$ ($L_2$)
        \item cells $297$k $\to$ $600$k, reference $813$k
      \end{itemize}
    \end{column}
  \end{columns}
\end{frame}

\section{Perspectives}
\outlineframe{3}

\begin{frame}{Perspectives}
  \begin{columns}[T]
    \begin{column}{0.49\textwidth}
      \textbf{Physics}
      \begin{itemize}\small
        \item Longer L8 production runs
        \item 3D animation and restart from $t=300$ dumps
        \item Compare with the 2D limiting case
      \end{itemize}
      \vspace{0.2cm}
      \textbf{Methods}
      \begin{itemize}\small
        \item Complete the $T=30$ AMR campaign (multi-ratio fix)
        \item Faster AMR tagging and regrid on GPU
      \end{itemize}
    \end{column}
    \begin{column}{0.49\textwidth}
      \textbf{Open questions}
      \begin{itemize}\small
        \item Reconnection vs coalescence: quantitative criterion in 3D
        \item Role of the varicose perturbation at later times
        \item Cost of accuracy: AMR vs fixed grid at equal error
      \end{itemize}
      \vspace{0.2cm}
      \begin{block}{Goal}
        Measure the numerical cost of 3D vortex coalescence, not assume it.
      \end{block}
    \end{column}
  \end{columns}
\end{frame}

