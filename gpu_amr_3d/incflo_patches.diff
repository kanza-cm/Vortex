diff --git a/src/prob/prob_init_fluid_usr.cpp b/src/prob/prob_init_fluid_usr.cpp
index bb48682..9185ebf 100644
--- a/src/prob/prob_init_fluid_usr.cpp
+++ b/src/prob/prob_init_fluid_usr.cpp
@@ -2,4 +2,73 @@
 
 using namespace amrex;
 
-// This is just a placeholder file
+// Caso "vortex tubes" (probtype 1001): due tubi di vorticità co-rotanti
+// con perturbazione assiale varicose del distacco e assi inclinati a X
+// nel piano x-z, come saetta3d.c (Basilisk CENTERED, GPU).
+//
+//   d(z) = DD * (1 + PERT*cos(2 pi z / LZ))    distacco varicose
+//   X(z) = TILT * DD * (z - LZ/2)/(LZ/2)       inclinazione dei centri
+//
+// Campo di velocità azimutale attorno a ciascun tubo (a divergenza
+// nulla), somma dei contributi dei due nuclei:
+//
+//   u_theta(r) = sigma^2/(2 r) (1 - exp(-r^2/sigma^2))
+//
+// I parametri si leggono dalla sezione "saetta" degli inputs
+// (saetta.DD, saetta.SIGMA, saetta.PERT, saetta.TILT, saetta.LZ);
+// i default coincidono con quelli di saetta3d.c.
+
+void incflo::init_vortex_tubes (Box const& vbx, Box const& /*gbx*/,
+                                Array4<Real> const& vel,
+                                Array4<Real> const& /*density*/,
+                                Array4<Real> const& /*tracer*/,
+                                Box const& /*domain*/,
+                                GpuArray<Real, AMREX_SPACEDIM> const& dx,
+                                GpuArray<Real, AMREX_SPACEDIM> const& problo,
+                                GpuArray<Real, AMREX_SPACEDIM> const& /*probhi*/)
+{
+    ParmParse pp("saetta");
+    Real dd    = Real(0.14);   // semi distacco dei nuclei (2D: d = 0.28)
+    Real sigma = Real(0.09);   // larghezza dei nuclei
+    Real pert  = Real(0.10);   // perturbazione assiale (frazione di DD)
+    Real tilt  = Real(2.0);    // inclinazione X (fase ~8 gradi)
+    Real lz    = Real(4.0);    // lunghezza del dominio lungo z
+    pp.query("DD", dd);
+    pp.query("SIGMA", sigma);
+    pp.query("PERT", pert);
+    pp.query("TILT", tilt);
+    pp.query("LZ", lz);
+
+    const Real slope = tilt*dd/(Real(0.5)*lz);
+    const Real twopi = Real(2.0)*Real(3.1415926535897932);
+
+    ParallelFor(vbx, [=] AMREX_GPU_DEVICE (int i, int j, int k) noexcept
+    {
+        Real x = problo[0] + (Real(i) + Real(0.5))*dx[0];
+        Real y = problo[1] + (Real(j) + Real(0.5))*dx[1];
+        Real z = problo[2] + (Real(k) + Real(0.5))*dx[2];
+
+        Real u = Real(0.0), v = Real(0.0);
+
+        for (int s = -1; s <= 1; s += 2)
+        {
+            Real xc = s*dd*(Real(1.0) + pert*std::cos(twopi*z/lz))
+                    - s*slope*(z - Real(0.5)*lz);
+            Real dxr = x - xc;
+            Real r = std::sqrt(dxr*dxr + y*y);
+            if (r > Real(0.0))
+            {
+                Real ut = Real(0.5)*sigma*sigma
+                        * (Real(1.0) - std::exp(-(r*r)/(sigma*sigma)))/r;
+                u += -ut*y/r;
+                v +=  ut*dxr/r;
+            }
+        }
+
+        vel(i,j,k,0) = u;
+        vel(i,j,k,1) = v;
+#if (AMREX_SPACEDIM == 3)
+        vel(i,j,k,2) = Real(0.0);
+#endif
+    });
+}
